# Local development only. Never commit a real key.
# Google AI Studio / Gemini API key — used for editorial selection and web search.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Optional until the feedback buttons are activated on Render.
GITHUB_REPOSITORY=Brogede16/kobo-morgenavis
GITHUB_FEEDBACK_BRANCH=feedback-data
GITHUB_FEEDBACK_TOKEN=
# A Google API key is not sufficient for private Drive uploads. Use OAuth:
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# Alternative only: a base64 Google service-account JSON file.
GOOGLE_SERVICE_ACCOUNT_JSON_B64=
RUN_NOW_TOKEN=change-me
ADMIN_USERNAME=mads
ADMIN_PASSWORD=choose-a-long-unique-password
